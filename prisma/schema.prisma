generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================
enum Role {
  SUPER_ADMIN
  ADMIN_PERTANIAN
  ADMIN_KEUANGAN
  PETUGAS_LAPANGAN
}

enum StatusKesehatan {
  SEHAT
  PERLU_PERHATIAN
  SAKIT
  MATI
}

enum StatusKaryawan {
  TETAP
  TIDAK_TETAP
  PENDUKUNG
}

enum StatusGaji {
  SUDAH_DIBAYAR
  PENDING
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
  TRANSFER
}

enum TipeDokumenPenjualan {
  PENAWARAN
  PESANAN
  PROFORMA
  TUKAR_FAKTUR
  PENAGIHAN
}

enum TipeTagihan {
  HUTANG
  PIUTANG
}

enum StatusTagihan {
  BELUM_LUNAS
  LUNAS_SEBAGIAN
  LUNAS
}

enum SumberDana {
  KAS
  BANK
  TABUNGAN
}

enum JenisStok {
  MASUK
  KELUAR
}

enum GeotagSource {
  GPS
  EXIF
  MANUAL
}

enum JenisPerawatan {
  PUPUK
  OBAT
  LAIN
}

enum StatusJadwal {
  RENCANA
  SELESAI
  BATAL
}

enum KelompokCOA {
  Aset
  Kewajiban
  Modal
  Pendapatan
  Beban
}

enum TipeAkunCOA {
  PEMASUKAN
  PENGELUARAN
  NETRAL
}

// ===================== MODELS =====================

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String   @unique
  password  String // hashed with bcrypt
  role      Role     @default(ADMIN_PERTANIAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi
  riwayatDitangani RiwayatKesehatan[] @relation("PetugasRiwayat")
  transaksiKas     TransaksiKas[]     @relation("AdminKas")
  tagihan          Tagihan[]          @relation("AdminTagihan")
  geotagPohon     Pohon[]            @relation("GeotagAdmin")
  panen           Panen[]            @relation("PetugasPanen")
  jadwalDibuat    JadwalPerawatan[]  @relation("JadwalCreatedBy")
  akunCOA         AkunCOA[]          @relation("AkunCreatedBy")
  dokumenPenjualan DokumenPenjualan[] @relation("DokumenCreatedBy")
  pengiriman      PengirimanPenjualan[] @relation("PengirimanAdmin")
  fakturPembelian FakturPembelian[] @relation("FakturBeliCreatedBy")

  @@map("users")
}

model AkunCOA {
  id          String       @id @default(cuid())
  kode        String       @unique
  nama        String
  kelompok    KelompokCOA
  golongan    String
  tipe        TipeAkunCOA
  deskripsi   String?      @db.Text
  isActive    Boolean      @default(true)
  createdById String?
  createdBy   User?        @relation("AkunCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([kelompok])
  @@index([golongan])
  @@index([kode])
  @@map("akun_coa")
}

model Pohon {
  id           String            @id // Custom ID ex: PHN-BLK-A01
  namaPohon    String? // NAMA POHON ex: Pohon Sawit 001
  varietas     String
  jenis        String? // JENIS ex: Sawit, Durian, Karet
  lokasiBlok   String // BLOK
  tanggalTanam DateTime // TANGGAL TANAM
  koordinat    String? // KOORDINAT ex: -2.983, 104.752
  hasilPanen   Decimal? @db.Decimal(10, 2) // HASIL PANEN KG
  pemupukan    String?  @db.Text // PEMUPUKAN - riwayat pupuk terakhir
  pengobatan   String?  @db.Text // PENGOBATAN - riwayat obat terakhir
  // Geotagging wajib - foto terbaru per pohon
  fotoGeotagUrl   String?  // URL foto geotag terbaru
  latitude        Float?   @db.DoublePrecision // -90..90
  longitude       Float?   @db.DoublePrecision // -180..180
  geotagAccuracy  Float?   @db.DoublePrecision // meter
  geotagTimestamp DateTime? // waktu capture geotag
  geotagSource    GeotagSource? // GPS | EXIF | MANUAL
  geotagAdminId   String?
  geotagAdmin     User?    @relation("GeotagAdmin", fields: [geotagAdminId], references: [id], onDelete: SetNull)
  geotagUpdatedAt DateTime? @updatedAt
  status       StatusKesehatan   @default(SEHAT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  riwayat RiwayatKesehatan[]
  panen   Panen[]
  jadwal  JadwalPerawatan[]

  @@index([lokasiBlok])
  @@index([status])
  @@index([jenis])
  @@index([tanggalTanam])
  @@index([geotagAdminId])
  @@index([geotagTimestamp])
  @@map("pohon")
}

model RiwayatKesehatan {
  id         String   @id @default(cuid())
  pohonId    String
  pohon      Pohon    @relation(fields: [pohonId], references: [id], onDelete: Cascade)

  gejala     String   @db.Text
  tindakan   String   @db.Text
  fotoUrl    String? // URL publik cloud storage (bukan blob)
  tanggalCek DateTime @default(now())

  petugasId String
  petugas   User   @relation("PetugasRiwayat", fields: [petugasId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([pohonId])
  @@index([petugasId])
  @@index([tanggalCek])
  @@map("riwayat_kesehatan")
}

model Karyawan {
  id           String         @id // Custom ID ex: EMP-001
  namaLengkap  String
  jabatan      String
  statusKerja  StatusKaryawan
  gajiPokok    Decimal        @db.Decimal(15, 2)
  tanggalMasuk DateTime
  telepon      String?
  email        String?
  alamat       String?        @db.Text
  tanggalLahir DateTime?
  jenisKelamin JenisKelamin?
  lokasiKerja  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  riwayatGaji RiwayatGaji[]

  @@index([statusKerja])
  @@index([lokasiKerja])
  @@map("karyawan")
}

model RiwayatGaji {
  id         String     @id @default(cuid())
  karyawanId String
  karyawan   Karyawan   @relation(fields: [karyawanId], references: [id], onDelete: Cascade)

  bulanTahun String // Format: YYYY-MM ex: 2026-09
  totalGaji  Decimal  @db.Decimal(15, 2)
  status     StatusGaji @default(PENDING)
  tanggalBayar DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([karyawanId, bulanTahun])
  @@index([status])
  @@map("riwayat_gaji")
}

model Aset {
  id                String   @id // Custom ID ex: AST-001
  namaAset          String
  jumlah            Int      @default(1)
  kategori          String // kategori COA aset, ex: Tanah, Mesin & Peralatan Pertanian/Peternakan
  kondisi           String // ex: Baik, Rusak Ringan, Rusak Berat
  status            String   @default("Aktif") // status penggunaan/keberadaan aset
  nilaiAset         Decimal  @db.Decimal(15, 2)
  tanggalPerolehan  DateTime? // tanggal perolehan aset
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("aset")
}

model TransaksiKas {
  id         String        @id @default(cuid())
  tipe       TipeTransaksi
  kategori   String // ex: Pendapatan Penjualan Hasil Kebun, Beban Pupuk dan Obat-obatan
  kodeAkun   String? // kode akun COA, ex: 4101 (nullable utk data lama)
  sumberDana SumberDana   @default(KAS)
  sumberDanaTujuan SumberDana? // akun tujuan utk TRANSFER antar Kas/Bank/Tabungan
  jumlah     Decimal       @db.Decimal(15, 2)
  keterangan String?       @db.Text
  tanggal    DateTime      @default(now())
  // Field gaya Mekari untuk form Terima/Kirim/Transfer Uang
  noTransaksi String?  @unique // ex: TRF-20260917-AB12 (auto-generate bila kosong)
  pihak       String? // Yang Membayar (Terima) / Penerima (Kirim), opsional
  tag         String? // Tag transaksi, opsional
  deskripsi   String?  @db.Text // Deskripsi rincian akun (Terima/Kirim), opsional

  adminId String
  admin   User   @relation("AdminKas", fields: [adminId], references: [id], onDelete: Restrict)

  bukti BuktiTransaksi[]

  tagihanId String?
  tagihan   Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tipe])
  @@index([kategori])
  @@index([sumberDana])
  @@index([tanggal])
  @@index([adminId])
  @@index([tagihanId])
  @@map("transaksi_kas")
}

model Tagihan {
  id          String        @id @default(cuid())
  tipe        TipeTagihan
  pihak       String // ex: nama tengkulak / supplier
  keterangan  String?       @db.Text
  jumlah      Decimal       @db.Decimal(15, 2)
  sisa        Decimal       @db.Decimal(15, 2)
  tanggal     DateTime      @default(now())
  jatuhTempo  DateTime?
  status      StatusTagihan @default(BELUM_LUNAS)
  // Persiapan modul Penjualan (diisi form Penagihan tahap berikut; nullable agar baris lama aman)
  noInvoice String? @unique // Nomor invoice penjualan, ex: INV-20260917-AB12
  jenis     String? // Jenis produk penjualan: HASIL_KEBUN | TERNAK | IKAN | LAINNYA
  dokumen   String? // Jenis dokumen penjualan: PENAGIHAN | PROFORMA | TUKAR_FAKTUR (null = Penagihan)

  adminId String
  admin   User   @relation("AdminTagihan", fields: [adminId], references: [id], onDelete: Restrict)

  pembayaran TransaksiKas[]

  dokumenPenjualan DokumenPenjualan?

  fakturPembelian FakturPembelian?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipe])
  @@index([status])
  @@index([jatuhTempo])
  @@index([adminId])
  @@map("tagihan")
}

model BuktiTransaksi {
  id          String       @id @default(cuid())
  transaksiId String
  transaksi   TransaksiKas @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  fileName    String // nama file asli untuk tampilan/download
  fileUrl     String // path yang bisa diakses, ex: /uploads/bukti-transaksi/xxx.pdf
  fileType    String // MIME type
  fileSize    Int // byte
  createdAt   DateTime     @default(now())

  @@index([transaksiId])
  @@map("bukti_transaksi")
}

model PersediaanBarang {
  id              String   @id // Kode barang, ex: BRG-001 (unik)
  namaBarang      String
  kategori        String // Bibit/Benih | Pupuk & Obat-obatan | Pakan Ternak/Ikan
  kodeAkunCOA     String?  // Kode akun COA persediaan (ex: 1105, 1106, 1107) - optional untuk backward compat
  stokAwal        Int      @default(0)
  satuan          String // kg, liter, pcs, karung
  hargaSatuan     Decimal  @db.Decimal(15, 2)
  keterangan      String? @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  riwayat RiwayatStok[]

  @@index([kategori])
  @@map("persediaan_barang")
}

model RiwayatStok {
  id         String         @id @default(cuid())
  barangId   String
  barang     PersediaanBarang @relation(fields: [barangId], references: [id], onDelete: Cascade)
  jenis      JenisStok
  jumlah     Int
  keterangan String?        @db.Text
  tanggal    DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([barangId])
  @@index([tanggal])
  @@map("riwayat_stok")
}

model Panen {
  id          String   @id @default(cuid())
  pohonId     String
  pohon       Pohon    @relation(fields: [pohonId], references: [id], onDelete: Cascade)
  tanggalPanen DateTime @default(now())
  jumlahKg    Decimal  @db.Decimal(10, 2)
  petugasId   String?
  petugas     User?    @relation("PetugasPanen", fields: [petugasId], references: [id], onDelete: SetNull)
  catatan     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([pohonId])
  @@index([tanggalPanen])
  @@index([petugasId])
  @@map("panen")
}

model Blok {
  id        String   @id @default(cuid())
  kode      String   @unique // A, B, C, D
  nama      String   @unique // Blok A
  luasHa    Float?   @db.DoublePrecision
  createdAt DateTime @default(now())

  @@map("blok")
}

// ===================== MODUL PENJUALAN =====================
// Alur: Penawaran -> Pesanan -> Pengiriman -> Proforma/Tukar Faktur -> Penagihan
//   -> Piutang (Tagihan) -> Pembayaran -> Kas & Bank (TransaksiKas) -> COA.
// Hanya PENAGIHAN yang menghasilkan Tagihan PIUTANG. Dokumen lain tidak
// menyentuh Kas & Bank.

model Pelanggan {
  id        String   @id @default(cuid())
  nama      String
  email     String?
  telepon   String?
  alamat    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dokumen DokumenPenjualan[]

  pengiriman PengirimanPenjualan[]

  @@index([nama])
  @@map("pelanggan")
}

model DokumenPenjualan {
  id               String                @id @default(cuid())
  tipe             TipeDokumenPenjualan
  noDokumen        String                @unique // ex: INV-20260917-AB12 (auto)
  pelangganId      String
  pelanggan        Pelanggan             @relation(fields: [pelangganId], references: [id], onDelete: Restrict)
  email            String?
  alamat           String?               @db.Text
  tanggal          DateTime              @default(now())
  jatuhTempo       DateTime? // tempo / target / kedaluwarsa sesuai tipe
  noRefPelanggan   String?
  syaratPembayaran String?
  pesan            String?               @db.Text
  memo             String?               @db.Text
  subtotal         Decimal               @db.Decimal(15, 2)
  total            Decimal               @db.Decimal(15, 2)
  status           String                @default("TERBUKA")
  // Rantai dokumen: id Tagihan/Dokumen sumber (Tukar Faktur merujuk faktur asal)
  referensiIds String[] @default([])
  // Piutang yang dihasilkan (hanya tipe PENAGIHAN)
  tagihanId String?  @unique
  tagihan   Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: SetNull)

  adminId String
  admin   User   @relation("DokumenCreatedBy", fields: [adminId], references: [id], onDelete: Restrict)

  items    DokumenPenjualanItem[]
  lampiran DokumenLampiran[]
  pengiriman PengirimanPenjualan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tipe])
  @@index([pelangganId])
  @@index([tanggal])
  @@index([tagihanId])
  @@map("dokumen_penjualan")
}

model DokumenPenjualanItem {
  id           String           @id @default(cuid())
  dokumenId    String
  dokumen      DokumenPenjualan @relation(fields: [dokumenId], references: [id], onDelete: Cascade)
  produkId     String? // id PersediaanBarang (snapshot, tanpa FK agar master bebas berubah)
  deskripsi    String
  kuantitas    Decimal          @db.Decimal(12, 2)
  unit         String
  harga        Decimal          @db.Decimal(15, 2)
  diskonPersen Decimal          @db.Decimal(5, 2) @default(0)
  jumlah       Decimal          @db.Decimal(15, 2)

  @@index([dokumenId])
  @@map("dokumen_penjualan_item")
}

model DokumenLampiran {
  id        String           @id @default(cuid())
  dokumenId String
  dokumen   DokumenPenjualan @relation(fields: [dokumenId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime         @default(now())

  @@index([dokumenId])
  @@map("dokumen_penjualan_lampiran")
}

model JadwalPerawatan {
  id             String         @id @default(cuid())
  blok           String
  pohonId        String?
  pohon          Pohon?         @relation(fields: [pohonId], references: [id], onDelete: Cascade)
  jenis          JenisPerawatan
  tanggalRencana DateTime
  status         StatusJadwal   @default(RENCANA)
  catatan        String?        @db.Text
  createdById    String?
  createdBy      User?          @relation("JadwalCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())

  @@index([blok])
  @@index([tanggalRencana])
  @@index([status])
  @@map("jadwal_perawatan")
}

model PengirimanPenjualan {
  id               String   @id @default(cuid())
  noPengiriman     String   @unique
  pesananId        String
  pesanan          DokumenPenjualan @relation(fields: [pesananId], references: [id], onDelete: Restrict)
  pelangganId      String
  pelanggan        Pelanggan @relation(fields: [pelangganId], references: [id], onDelete: Restrict)
  alamatPengiriman String?  @db.Text
  tanggalPengiriman DateTime?
  noTransaksi      String?
  noRefPelanggan   String?
  kirimMelalui     String?
  noPelacakan      String?
  gudang           String?
  pesan            String?  @db.Text
  memo             String?  @db.Text
  adminId          String
  admin            User     @relation("PengirimanAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  items            PengirimanItem[]
  lampiran         PengirimanLampiran[]

  @@index([pesananId])
  @@index([pelangganId])
  @@map("pengiriman_penjualan")
}

model PengirimanItem {
  id              String   @id @default(cuid())
  pengirimanId    String
  pengiriman      PengirimanPenjualan @relation(fields: [pengirimanId], references: [id], onDelete: Cascade)
  deskripsi       String
  kuantitas       Decimal  @db.Decimal(12,2)
  unit            String
  harga           Decimal  @db.Decimal(15,2)
  jumlah          Decimal  @db.Decimal(15,2)

  @@index([pengirimanId])
  @@map("pengiriman_item")
}

model PengirimanLampiran {
  id            String   @id @default(cuid())
  pengirimanId  String
  pengiriman    PengirimanPenjualan @relation(fields: [pengirimanId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileType      String
  fileSize      Int
  createdAt     DateTime @default(now())

  @@index([pengirimanId])
  @@map("pengiriman_lampiran")
}

// ===================== MODUL PEMBELIAN =====================
// Alur: Pesanan Pembelian -> Pengiriman Pembelian -> Faktur Pembelian
//   -> Utang (Tagihan HUTANG) -> Pembayaran -> Kas & Bank (TransaksiKas) -> COA.
// Hanya FAKTUR yang menghasilkan Tagihan HUTANG. Tanpa Kas & Bank saat faktur
// dibuat (supplier belum dibayar). Sisi DEBIT dicatat per baris via kodeAkun
// (1105/1106/1107 persediaan atau akun Beban); sisi KREDIT = 2101 Utang Usaha
// yang diwakili Tagihan HUTANG. Pembayaran memakai alur Tagihan yang sudah ada
// (tanpa mencatat pembelian/persediaan lagi). Tidak menyentuh RiwayatStok agar
// tidak ganda dengan alur pembelian persediaan yang sudah ada.

model Supplier {
  id        String   @id @default(cuid())
  nama      String
  email     String?
  telepon   String?
  alamat    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faktur FakturPembelian[]

  @@index([nama])
  @@map("supplier")
}

model FakturPembelian {
  id               String    @id @default(cuid())
  noFaktur         String    @unique // ex: FB-20260918-AB12 (auto)
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  email            String?
  alamat           String?   @db.Text
  tanggal          DateTime  @default(now())
  jatuhTempo       DateTime?
  noRefSupplier    String?
  syaratPembayaran String?
  gudang           String? // teks bebas (belum ada master gudang)
  tag              String?
  pesan            String?   @db.Text
  memo             String?   @db.Text
  subtotal         Decimal   @db.Decimal(15, 2)
  total            Decimal   @db.Decimal(15, 2)
  // Utang yang dihasilkan (satu faktur = satu utang)
  tagihanId String?  @unique
  tagihan   Tagihan? @relation(fields: [tagihanId], references: [id], onDelete: SetNull)

  adminId String
  admin   User   @relation("FakturBeliCreatedBy", fields: [adminId], references: [id], onDelete: Restrict)

  items    FakturPembelianItem[]
  lampiran FakturPembelianLampiran[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([tanggal])
  @@index([tagihanId])
  @@map("faktur_pembelian")
}

model FakturPembelianItem {
  id           String          @id @default(cuid())
  fakturId     String
  faktur       FakturPembelian @relation(fields: [fakturId], references: [id], onDelete: Cascade)
  produkId     String? // id PersediaanBarang (snapshot, tanpa FK agar master bebas berubah)
  deskripsi    String
  kuantitas    Decimal         @db.Decimal(12, 2)
  unit         String
  harga        Decimal         @db.Decimal(15, 2)
  diskonPersen Decimal         @db.Decimal(5, 2) @default(0)
  kodeAkun     String? // akun DEBIT baris ini (1105/1106/1107/Beban), dari COA database
  jumlah       Decimal         @db.Decimal(15, 2)

  @@index([fakturId])
  @@map("faktur_pembelian_item")
}

model FakturPembelianLampiran {
  id        String          @id @default(cuid())
  fakturId  String
  faktur    FakturPembelian @relation(fields: [fakturId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime        @default(now())

  @@index([fakturId])
  @@map("faktur_pembelian_lampiran")
}
