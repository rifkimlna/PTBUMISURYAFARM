generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===================== ENUMS =====================
enum Role {
  SUPER_ADMIN
  ADMIN_PERTANIAN
  ADMIN_KEUANGAN
}

enum StatusKesehatan {
  SEHAT
  PERLU_PERHATIAN
  SAKIT
  MATI
}

enum StatusKaryawan {
  TETAP
  KONTRAK
  HARIAN
}

enum StatusGaji {
  SUDAH_DIBAYAR
  PENDING
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum TipeTransaksi {
  PEMASUKAN
  PENGELUARAN
}

enum SumberDana {
  KAS
  BANK
  TABUNGAN
}

enum JenisStok {
  MASUK
  KELUAR
}

enum GeotagSource {
  GPS
  EXIF
  MANUAL
}

// ===================== MODELS =====================

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String   @unique
  password  String // hashed with bcrypt
  role      Role     @default(ADMIN_PERTANIAN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relasi
  riwayatDitangani RiwayatKesehatan[] @relation("PetugasRiwayat")
  transaksiKas     TransaksiKas[]     @relation("AdminKas")
  geotagPohon     Pohon[]            @relation("GeotagAdmin")

  @@map("users")
}

model Pohon {
  id           String            @id // Custom ID ex: PHN-BLK-A01
  namaPohon    String? // NAMA POHON ex: Pohon Sawit 001
  varietas     String
  jenis        String? // JENIS ex: Sawit, Durian, Karet
  lokasiBlok   String // BLOK
  tanggalTanam DateTime // TANGGAL TANAM
  koordinat    String? // KOORDINAT ex: -2.983, 104.752
  hasilPanen   Decimal? @db.Decimal(10, 2) // HASIL PANEN KG
  pemupukan    String?  @db.Text // PEMUPUKAN - riwayat pupuk terakhir
  pengobatan   String?  @db.Text // PENGOBATAN - riwayat obat terakhir
  // Geotagging wajib - foto terbaru per pohon
  fotoGeotagUrl   String?  // URL foto geotag terbaru
  latitude        Float?   @db.DoublePrecision // -90..90
  longitude       Float?   @db.DoublePrecision // -180..180
  geotagAccuracy  Float?   @db.DoublePrecision // meter
  geotagTimestamp DateTime? // waktu capture geotag
  geotagSource    GeotagSource? // GPS | EXIF | MANUAL
  geotagAdminId   String?
  geotagAdmin     User?    @relation("GeotagAdmin", fields: [geotagAdminId], references: [id], onDelete: SetNull)
  geotagUpdatedAt DateTime? @updatedAt
  status       StatusKesehatan   @default(SEHAT)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  riwayat RiwayatKesehatan[]

  @@index([lokasiBlok])
  @@index([status])
  @@index([jenis])
  @@index([tanggalTanam])
  @@index([geotagAdminId])
  @@index([geotagTimestamp])
  @@map("pohon")
}

model RiwayatKesehatan {
  id         String   @id @default(cuid())
  pohonId    String
  pohon      Pohon    @relation(fields: [pohonId], references: [id], onDelete: Cascade)

  gejala     String   @db.Text
  tindakan   String   @db.Text
  fotoUrl    String? // URL publik cloud storage (bukan blob)
  tanggalCek DateTime @default(now())

  petugasId String
  petugas   User   @relation("PetugasRiwayat", fields: [petugasId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([pohonId])
  @@index([petugasId])
  @@index([tanggalCek])
  @@map("riwayat_kesehatan")
}

model Karyawan {
  id           String         @id // Custom ID ex: EMP-001
  namaLengkap  String
  jabatan      String
  statusKerja  StatusKaryawan
  gajiPokok    Decimal        @db.Decimal(15, 2)
  tanggalMasuk DateTime
  telepon      String?
  email        String?
  alamat       String?        @db.Text
  tanggalLahir DateTime?
  jenisKelamin JenisKelamin?
  divisi       String?
  lokasiKerja  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  riwayatGaji RiwayatGaji[]

  @@index([statusKerja])
  @@index([divisi])
  @@index([lokasiKerja])
  @@map("karyawan")
}

model RiwayatGaji {
  id         String     @id @default(cuid())
  karyawanId String
  karyawan   Karyawan   @relation(fields: [karyawanId], references: [id], onDelete: Cascade)

  bulanTahun String // Format: YYYY-MM ex: 2026-09
  totalGaji  Decimal  @db.Decimal(15, 2)
  status     StatusGaji @default(PENDING)
  tanggalBayar DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([karyawanId, bulanTahun])
  @@index([status])
  @@map("riwayat_gaji")
}

model Aset {
  id                String   @id // Custom ID ex: AST-001
  namaAset          String
  jumlah            Int      @default(1)
  kategori          String // kategori COA aset, ex: Tanah, Mesin & Peralatan Pertanian/Peternakan
  kondisi           String // ex: Baik, Rusak Ringan, Rusak Berat
  status            String   @default("Aktif") // status penggunaan/keberadaan aset
  nilaiAset         Decimal  @db.Decimal(15, 2)
  tanggalPerolehan  DateTime? // tanggal perolehan aset
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("aset")
}

model TransaksiKas {
  id         String        @id @default(cuid())
  tipe       TipeTransaksi
  kategori   String // ex: Pendapatan Penjualan Hasil Kebun, Beban Pupuk dan Obat-obatan
  kodeAkun   String? // kode akun COA, ex: 4101 (nullable utk data lama)
  sumberDana SumberDana   @default(KAS)
  jumlah     Decimal       @db.Decimal(15, 2)
  keterangan String?       @db.Text
  tanggal    DateTime      @default(now())

  adminId String
  admin   User   @relation("AdminKas", fields: [adminId], references: [id], onDelete: Restrict)

  bukti BuktiTransaksi[]

  createdAt DateTime @default(now())

  @@index([tipe])
  @@index([kategori])
  @@index([sumberDana])
  @@index([tanggal])
  @@index([adminId])
  @@map("transaksi_kas")
}

model BuktiTransaksi {
  id          String       @id @default(cuid())
  transaksiId String
  transaksi   TransaksiKas @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  fileName    String // nama file asli untuk tampilan/download
  fileUrl     String // path yang bisa diakses, ex: /uploads/bukti-transaksi/xxx.pdf
  fileType    String // MIME type
  fileSize    Int // byte
  createdAt   DateTime     @default(now())

  @@index([transaksiId])
  @@map("bukti_transaksi")
}

model PersediaanBarang {
  id          String   @id // Kode barang, ex: BRG-001 (unik)
  namaBarang  String
  kategori    String // Bibit/Benih | Pupuk & Obat-obatan | Pakan Ternak/Ikan
  stokAwal    Int      @default(0)
  satuan      String // kg, liter, pcs, karung
  hargaSatuan Decimal  @db.Decimal(15, 2)
  keterangan  String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  riwayat RiwayatStok[]

  @@index([kategori])
  @@map("persediaan_barang")
}

model RiwayatStok {
  id         String         @id @default(cuid())
  barangId   String
  barang     PersediaanBarang @relation(fields: [barangId], references: [id], onDelete: Cascade)
  jenis      JenisStok
  jumlah     Int
  keterangan String?        @db.Text
  tanggal    DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([barangId])
  @@index([tanggal])
  @@map("riwayat_stok")
}
