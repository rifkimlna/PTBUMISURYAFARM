# Copy file ini jadi .env -> cp .env.example .env
# Lokal boleh pakai localhost, Production (Vercel) WAJIB pakai Neon pooler.
# Contoh Neon pooler:
# DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?channel_binding=require&sslmode=verify-full"
# Untuk migrate/seed langsung (bypass pooler), pakai host tanpa "-pooler":
# DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxx.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full"

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pt_bst"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@localhost:5432/pt_bst"
JWT_SECRET="ganti-minimal-32-karakter-acak-untuk-dev"
JWT_EXPIRES_IN="7d"

# Wajib di production (Vercel) agar foto tampil - local disk tidak persist di Vercel.
# Dev boleh kosong (fallback ke public/uploads).
# Di server prioritaskan SERVICE_ROLE (bypass RLS insert), ANON_KEY sebagai fallback.
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_ANON_KEY=""
# SUPABASE_BUCKET="pt-bst"
